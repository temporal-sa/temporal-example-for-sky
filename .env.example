# Every variable the demo reads. docker-compose.yml sets them for `make up`; copy to .env only to
# override. .env is gitignored.

# Temporal gRPC endpoint. Inside Compose this is the dev server at temporal:7233.
TEMPORAL_ADDRESS=temporal:7233
# Namespace on the Temporal server.
TEMPORAL_NAMESPACE=default
# Temporal Cloud API key. Leave empty for the local dev server.
TEMPORAL_API_KEY=
# The Task Queue the Worker polls and the API starts orders on.
TEMPORAL_TASK_QUEUE=broadband-fulfilment
# Base URL for the "Open in Temporal UI" links the console shows.
TEMPORAL_UI_URL=http://localhost:8233
# Where the Worker and API reach the simulated provider and Portfolio.
DOWNSTREAM_URL=http://downstream:8090
